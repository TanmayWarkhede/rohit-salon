# Copy this file to .env and edit.
# Local MongoDB (the same address you type into Compass):
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=rohit_salon
PORT=3000
# Any long random text. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ---- Owner email alerts (optional) ----
# Gmail: turn on 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your-16-letter-app-password
# Where alerts go (separate several with commas)
OWNER_EMAIL=owner@example.com
# On free hosts that block SMTP (Render free), use Brevo's HTTPS API instead of SMTP_USER/SMTP_PASS:
# BREVO_API_KEY=your-brevo-api-key
# BREVO_SENDER=an-email-you-verified-in-brevo@example.com
# Other providers only: SMTP_HOST=smtp.example.com  SMTP_PORT=465
# Morning summary time (IST, 24h) and "customer arriving soon" reminder (minutes before; 0 = off)
DAILY_SUMMARY_TIME=09:00
REMINDER_MINUTES=30
